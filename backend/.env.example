DATABASE_URL=postgres://erp:erp_secret@localhost:5432/erp_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_this_in_production_very_long_secret_key_32bytes
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
RUST_LOG=info
APP_PORT=8080
APP_HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000

# Mail. Leave SMTP_HOST unset and mail is written to the log instead of sent —
# password reset links appear in the console, which is what you want locally.
# `docker compose up -d mailpit` gives you a catcher on 1025 with a web UI on
# http://localhost:8025, so the whole flow can be clicked through end to end.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_ENCRYPTION=none          # starttls (default) | tls | none
# SMTP_FROM=ERP System <no-reply@erp.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Uploaded receipts. Leave S3_ENDPOINT unset and upload is switched off — the
# endpoint refuses with a message naming these settings, rather than accepting a
# file and dropping it. `docker compose up -d minio` gives you a bucket on 9000
# with a console on http://localhost:9001; the backend creates the bucket itself
# on first start.
#
# S3_PUBLIC_ENDPOINT is what a *browser* can reach, and matters because a
# presigned URL's signature covers the host it was signed for. Only needed when
# that differs from S3_ENDPOINT, as it does inside a compose network.
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=erp-receipts
# S3_ACCESS_KEY=erp_minio
# S3_SECRET_KEY=erp_minio_secret
